# Copia este archivo a .env. Estos valores son de ejemplo: las credenciales reales se comparten por privado.
USER_AGENT=ribu

FACTUS_URL=https://api-sandbox.factus.com.co
FACTUS_CLIENT_ID=tu-client-id
FACTUS_CLIENT_SECRET=tu-client-secret
FACTUS_USUARIO=correo@ejemplo.com
FACTUS_CLAVE=tu-clave

FACTUS_PAY_URL=https://pay-api-sandbox.factus.com.co
FACTUS_PAY_TOKEN=tu-token
FACTUS_PAY_LLAVE_WEBHOOK=tu-llave-del-webhook
